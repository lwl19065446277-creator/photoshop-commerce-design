/* Bounded native PSD variants: exact text, visibility, embedded overlay, crop. */
function renderNativeVariant(planPath) {
 var pf=fileFor(planPath),p,root=canon(pf.parent),doc=null,overlayDoc=null,previous=app.documents.length?app.activeDocument:null;
 var oldRulers=app.preferences.rulerUnits,oldType=app.preferences.typeUnits,stage='preflight',edits=[],i;
 if(root.indexOf('/runs/')<0||!pf.exists)throw problem('INVALID_PLAN','Variant plan must be inside runs');
 pf.encoding='UTF8';pf.open('r');try{p=parseDataJSON(pf.read());}finally{pf.close();}
 if(p.kind!=='native-variant')throw problem('INVALID_PLAN','Expected native variant');
 var wf=workingFile(p.working);if(canon(wf.parent)!==root)throw problem('INVALID_WORKING','Working copy must be beside plan');
 var psd=outputFile(p.psd,p.working,'psd'),png=outputFile(p.png,p.working,'png'),jpg=outputFile(p.jpg,p.working,'jpg');
 var overlayFile=null;if(p.overlay){overlayFile=fileFor(p.overlay.path);if(canon(overlayFile).indexOf('/runs/')<0||!overlayFile.exists||!/\.(psd|png)$/i.test(overlayFile.name))throw problem('INVALID_OVERLAY','Overlay must be a staged PNG or PSD');}
 for(i=0;i<app.documents.length;i++){var opened=null;try{opened=app.documents[i].fullName;}catch(unsaved){}if(opened&&(canon(opened)===canon(wf)||(overlayFile&&canon(opened)===canon(overlayFile))))throw problem('DOCUMENT_ALREADY_OPEN','Variant input already open; inspect before retry');}
 function color(hex){var c=new SolidColor();c.rgb.hexValue=hex;return c;}
 function select(layerId){app.activeDocument=doc;var d=new ActionDescriptor(),r=new ActionReference();r.putIdentifier(charIDToTypeID('Lyr '),layerId);d.putReference(charIDToTypeID('null'),r);d.putBoolean(charIDToTypeID('MkVs'),false);executeAction(charIDToTypeID('slct'),d,DialogModes.NO);if(doc.activeLayer.id!==layerId)throw problem('LAYER_ID_MISMATCH','Unexpected layer');return doc.activeLayer;}
 function fit(layer,box){var b=layer.bounds,w=pixels(b[2])-pixels(b[0]),h=pixels(b[3])-pixels(b[1]);if(w<=0||h<=0)throw problem('EMPTY_LAYER','Cannot fit empty layer');var scale=Math.min(1,box[2]/w,box[3]/h)*100;if(scale<99.999)layer.resize(scale,scale,AnchorPosition.MIDDLECENTER);b=layer.bounds;w=pixels(b[2])-pixels(b[0]);h=pixels(b[3])-pixels(b[1]);layer.translate(UnitValue(box[0]+(box[2]-w)/2-pixels(b[0]),'px'),UnitValue(box[1]+(box[3]-h)/2-pixels(b[1]),'px'));}
 function textRuns(layer){var r=new ActionReference();r.putIdentifier(charIDToTypeID('Lyr '),layer.id);return descriptorData(executeActionGet(r).getObjectValue(stringIDToTypeID('textKey'))).textStyleRange;}
 function emphasize(layer,spec){
  var r=new ActionReference();r.putIdentifier(charIDToTypeID('Lyr '),layer.id);var key=executeActionGet(r).getObjectValue(stringIDToTypeID('textKey'));
  var base=key.getList(stringIDToTypeID('textStyleRange')).getObjectValue(0).getObjectValue(stringIDToTypeID('textStyle'));
  var start=spec.text.indexOf(spec.emphasis.text),end=start+spec.emphasis.text.length,cuts=[0,start,end,spec.text.length+1],list=new ActionList(),j;
  for(j=0;j<3;j++){if(cuts[j]===cuts[j+1])continue;var range=new ActionDescriptor(),style=new ActionDescriptor();style.fromStream(base.toStream());var rgb=new ActionDescriptor(),c=color(j===1?spec.emphasis.color:spec.color);rgb.putDouble(charIDToTypeID('Rd  '),c.rgb.red);rgb.putDouble(charIDToTypeID('Grn '),c.rgb.green);rgb.putDouble(charIDToTypeID('Bl  '),c.rgb.blue);style.putObject(stringIDToTypeID('color'),stringIDToTypeID('RGBColor'),rgb);range.putInteger(stringIDToTypeID('from'),cuts[j]);range.putInteger(stringIDToTypeID('to'),cuts[j+1]);range.putObject(stringIDToTypeID('textStyle'),stringIDToTypeID('textStyle'),style);list.putObject(stringIDToTypeID('textStyleRange'),range);}
  key.putList(stringIDToTypeID('textStyleRange'),list);var d=new ActionDescriptor();d.putReference(charIDToTypeID('null'),r);d.putObject(charIDToTypeID('T   '),stringIDToTypeID('textLayer'),key);executeAction(charIDToTypeID('setd'),d,DialogModes.NO);
 }
 try{
  app.preferences.rulerUnits=Units.PIXELS;app.preferences.typeUnits=TypeUnits.PIXELS;stage='open';doc=app.open(wf);app.activeDocument=doc;
  if(pixels(doc.width)!==p.width||pixels(doc.height)!==p.height)throw problem('SIZE_MISMATCH','Native source dimensions differ');
  for(i=0;i<p.visibility.length;i++){var v=p.visibility[i],l=select(v.id);if(l.name!==v.name)throw problem('VISIBILITY_PRECONDITION','Native layer name differs');}
  for(i=0;i<p.texts.length;i++){var t=p.texts[i],l=select(t.id);if(l.kind!==LayerKind.TEXT||l.textItem.contents!==t.expected)throw problem('TEXT_PRECONDITION','Native text differs from exact previous contents',{id:t.id});}
  stage='visibility';for(i=0;i<p.visibility.length;i++){var v=p.visibility[i],l=select(v.id);l.visible=v.visible;edits.push({operation:'visibility',id:l.id,name:l.name,visible:l.visible});}
  stage='text';for(i=0;i<p.texts.length;i++){var t=p.texts[i],l=select(t.id);l.textItem.contents=t.text;if(t.autoLeading)l.textItem.useAutoLeading=true;if(t.color)l.textItem.color=color(t.color);if(t.emphasis)emphasize(l,t);if(t.fit)fit(l,t.fit);if(l.textItem.contents!==t.text)throw problem('TEXT_READBACK','Native text readback differs');edits.push({operation:'text',id:l.id,text:l.textItem.contents,font:l.textItem.font,styleRanges:textRuns(l)});}
  if(p.overlay){stage='embedded-overlay';var anchor=select(p.overlay.aboveLayerId),place=new ActionDescriptor();place.putPath(charIDToTypeID('null'),overlayFile);place.putEnumerated(charIDToTypeID('FTcs'),charIDToTypeID('QCSt'),charIDToTypeID('Qcsa'));executeAction(charIDToTypeID('Plc '),place,DialogModes.NO);var placed=doc.activeLayer;if(placed.kind!==LayerKind.SMARTOBJECT)throw problem('OVERLAY_NOT_SMART_OBJECT','Native place did not create an embedded object');var b=placed.bounds,w=pixels(b[2])-pixels(b[0]),h=pixels(b[3])-pixels(b[1]),box=p.overlay.box;var scale=Math.min(box[2]/w,box[3]/h)*100;placed.resize(scale,scale,AnchorPosition.MIDDLECENTER);b=placed.bounds;placed.translate(UnitValue(box[0]-pixels(b[0]),'px'),UnitValue(box[1]-pixels(b[1]),'px'));placed.name=p.overlay.name;placed.move(anchor,ElementPlacement.PLACEBEFORE);var sr=new ActionReference();sr.putIdentifier(charIDToTypeID('Lyr '),placed.id);var so=executeActionGet(sr).getObjectValue(stringIDToTypeID('smartObject'));if(so.hasKey(stringIDToTypeID('linked'))&&so.getBoolean(stringIDToTypeID('linked')))throw problem('LINKED_OVERLAY','Overlay unexpectedly linked');edits.push({operation:'embedded-overlay',id:placed.id,path:overlayFile.fsName,sourceLayersPreservedInsidePsd:true,linked:false});}
  if(p.crop){stage='crop';var c=p.crop;doc.crop([UnitValue(c[0],'px'),UnitValue(c[1],'px'),UnitValue(c[0]+c[2],'px'),UnitValue(c[1]+c[3],'px')]);}
  stage='save';var opts=new PhotoshopSaveOptions();opts.layers=true;opts.embedColorProfile=true;opts.maximizeCompatibility=true;app.preferences.maximizeCompatibility=QueryStateType.ALWAYS;doc.saveAs(psd,opts,false,Extension.LOWERCASE);
  var po=new PNGSaveOptions();po.compression=6;doc.saveAs(png,po,true,Extension.LOWERCASE);var jo=new JPEGSaveOptions();jo.quality=11;jo.embedColorProfile=true;doc.saveAs(jpg,jo,true,Extension.LOWERCASE);
  var audit=auditDocument(doc);doc.close(SaveOptions.DONOTSAVECHANGES);doc=null;stage='reopen';doc=app.open(psd);var reopened=auditDocument(doc);
  return{backend:'real-com',kind:p.kind,name:p.name,psd:psd.fsName,png:png.fsName,jpg:jpg.fsName,width:pixels(doc.width),height:pixels(doc.height),edits:edits,audit:audit,reopen:reopened};
 }catch(e){throw problem(e.code||'NATIVE_VARIANT_FAILED',String(e.message||e),{stage:stage,edits:edits,outcome:'inspect-before-retry'});}
 finally{if(overlayDoc)try{overlayDoc.close(SaveOptions.DONOTSAVECHANGES);}catch(closeOverlay){}if(doc)try{doc.close(SaveOptions.DONOTSAVECHANGES);}catch(closeDoc){}app.preferences.rulerUnits=oldRulers;app.preferences.typeUnits=oldType;if(previous)try{app.activeDocument=previous;}catch(restorePrevious){}}
}
