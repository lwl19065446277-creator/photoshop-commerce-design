 function recolor(l){
  var fxKey=stringIDToTypeID('layerEffects'),gKey=stringIDToTypeID('gradientFill'),gradKey=stringIDToTypeID('gradient'),colorsKey=stringIDToTypeID('colors'),d=desc(l);
  if(!d.hasKey(fxKey))throw problem('GRADIENT_MISSING','Native price box has no effects');var fx=d.getObjectValue(fxKey),before=descriptorData(fx),g=fx.getObjectValue(gKey),grad=g.getObjectValue(gradKey),stops=grad.getList(colorsKey),newStops=new ActionList(),j;
  if(stops.count<2||stops.count>16||!g.getBoolean(stringIDToTypeID('enabled')))throw problem('UNEXPECTED_GRADIENT','Expected enabled native gradient with 2-16 color stops');
  for(j=0;j<stops.count;j++){var stop=stops.getObjectValue(j),rgb=new ActionDescriptor(),mix=stop.getInteger(stringIDToTypeID('location'))/4096,channels=['Rd  ','Grn ','Bl  '],ci;for(ci=0;ci<3;ci++){var start=parseInt(p.gradient[0].substr(ci*2,2),16),end=parseInt(p.gradient[1].substr(ci*2,2),16);rgb.putDouble(charIDToTypeID(channels[ci]),start+(end-start)*mix);}stop.putObject(stringIDToTypeID('color'),stringIDToTypeID('RGBColor'),rgb);newStops.putObject(stops.getObjectType(j),stop);}
  grad.putList(colorsKey,newStops);g.putObject(gradKey,stringIDToTypeID('gradientClassEvent'),grad);fx.putObject(gKey,stringIDToTypeID('gradientFill'),g);
  var set=new ActionDescriptor(),r=new ActionReference();r.putProperty(charIDToTypeID('Prpr'),fxKey);r.putIdentifier(charIDToTypeID('Lyr '),l.id);set.putReference(charIDToTypeID('null'),r);set.putObject(charIDToTypeID('T   '),fxKey,fx);executeAction(charIDToTypeID('setd'),set,DialogModes.NO);
  var after=descriptorData(desc(l).getObjectValue(fxKey)),beforeColors=parseDataJSON(json(before.gradientFill.value.gradient.value.colors)),afterColors=parseDataJSON(json(after.gradientFill.value.gradient.value.colors));
  // All style parameters except the two RGB colors must be identical.
  for(j=0;j<stops.count;j++){before.gradientFill.value.gradient.value.colors[j].value.color=null;after.gradientFill.value.gradient.value.colors[j].value.color=null;}
  // Photoshop localizes the display label of disabled contour presets on set.
  // Actual contour curve data, stops, opacity, direction and all other values stay checked.
  function normalizeLabels(o){var k;if(!o||typeof o!=='object')return;for(k in o)if(o.hasOwnProperty(k)){if(k==='transferSpec'&&o.enabled===false&&o[k].value&&o[k].value.name!==undefined)o[k].value.name='<contour-display-label>';normalizeLabels(o[k]);}}
  normalizeLabels(before);normalizeLabels(after);if(json(before)!==json(after))throw problem('STYLE_CHANGED','Non-color native effect properties changed');
  return{layerId:l.id,beforeColors:beforeColors,afterColors:afterColors,otherEffectPropertiesUnchanged:true,contourDisplayLabelNormalizationIgnored:true};
 }
 function saveRaster(d,f,format){var o;if(format==='png'){o=new PNGSaveOptions();o.compression=6;}else{o=new JPEGSaveOptions();o.quality=11;o.embedColorProfile=true;}d.saveAs(f,o,true,Extension.LOWERCASE);}
 try{
  if(p.kind!=='native-catalog'||!p.items||p.items.length>60)throw problem('INVALID_PLAN','Unsupported native catalog plan');var wf=workingFile(p.working);if(canon(wf.parent)!==root)throw problem('INVALID_WORKING','Working copy must be beside native plan');
  var psd=output(p.psd),png=output(p.png),jpg=output(p.jpg),targets=[];for(i=0;i<p.slices.length;i++){var s=p.slices[i];if(s.x<0||s.y<0||s.x+s.width>p.width||s.y+s.height>p.height)throw problem('INVALID_SLICE','Native slice exceeds canvas');targets.push({s:s,png:s.png?output(s.png):null,jpg:s.jpg?output(s.jpg):null});}
  for(i=0;i<app.documents.length;i++){var q=null;try{q=app.documents[i].fullName;}catch(e){}if(q&&canon(q)===canon(wf))throw problem('DOCUMENT_ALREADY_OPEN','Native working copy already open; inspect before retry');}
  for(i=0;i<p.items.length;i++){var a=fileFor(p.items[i].path);if(canon(a).indexOf('/runs/')<0||!a.exists)throw problem('ASSET_MISSING','Only staged run images supported');}
  app.preferences.rulerUnits=Units.PIXELS;app.preferences.typeUnits=TypeUnits.PIXELS;doc=app.open(wf);app.activeDocument=doc;if(pixels(doc.width)!==p.width)throw problem('WIDTH_MISMATCH','Native width changed');
  var template=nativeLayer(p.templateGroupId);if(!template||template.typename!=='LayerSet')throw problem('TEMPLATE_MISSING','Native group absent');var original=snapshot(doc,[template]);original.scope='canonical-native-product-group';
  for(i=0;i<p.hideGroupIds.length;i++){var h=nativeLayer(p.hideGroupIds[i]);if(!h)throw problem('GROUP_MISSING','Expected original group absent');h.visible=false;}
  if(pixels(doc.height)!==p.height)doc.resizeCanvas(UnitValue(p.width,'px'),UnitValue(p.height,'px'),AnchorPosition.TOPCENTER);
  var outGroup=doc.layerSets.add();outGroup.name='CATALOG_NATIVE_UPDATED';var outGroupId=outGroup.id;progress({phase:'start',name:p.name,items:p.items.length});
  var historyError=null;
  // Static callback only: requirement text never becomes an executable string.
