   stage='duplicate';var item=p.items[i];template=nativeLayer(p.templateGroupId);outGroup=nativeLayer(outGroupId);doc.activeLayer=template;var g=template.duplicate(outGroup,ElementPlacement.PLACEBEFORE);if(g.id===p.templateGroupId)throw problem('DUPLICATE_ID_COLLISION','Native duplicate must have a new ID');stage='duplicate-visibility';g.visible=true;g.name=('0'+(i+1)).slice(-2)+'_'+item.id+'_'+item.sku;var ls=flat(g.layers),sale=null,orig=null,saving=null,currency=null,priceBox=null,images=[],j;
   for(j=0;j<ls.length;j++){var l=ls[j];if(l.typename==='ArtLayer'&&l.kind===LayerKind.TEXT){var txt=l.textItem.contents;if(/^\s*\d+\s*$/.test(txt))sale=l;else if(/^[\uffe5\u00a5]\s*\d+/.test(txt))orig=l;else if(/^\u7acb\u7701\s*\d+/.test(txt))saving=l;else if(/^[\u00a5\uffe5]$/.test(txt))currency=l;}if(l.typename==='ArtLayer'&&l.kind===LayerKind.SMARTOBJECT&&/^(1440|800)-1/.test(l.name))images.push(l);if(l.typename==='ArtLayer'&&l.name.indexOf('\u77e9\u5f62 574')===0)priceBox=l;}
   if(!sale||!orig||!saving||!currency||!priceBox||!images.length)throw problem('NATIVE_STRUCTURE_MISMATCH','Expected native price/image layers missing',{item:item.id});
   stage='bounds';var imageLayer=images[0],imageBounds=bounds(imageLayer),oldSale=bounds(sale),oldOrig=bounds(orig),oldCurrency=bounds(currency),clusterCenter=(oldCurrency[0]+oldOrig[2])/2,gap=Math.max(oldOrig[0]-oldSale[2],10*p.width/1440),currencyGap=Math.max(oldSale[0]-oldCurrency[2],3*p.width/1440);
   var originals={sale:sale.textItem.contents,original:orig.textItem.contents,saving:saving.textItem.contents},fonts={sale:sale.textItem.font,original:orig.textItem.font,saving:saving.textItem.font},groupId=g.id,saleId=sale.id,origId=orig.id,savingId=saving.id,priceBoxId=priceBox.id,oldImageId=imageLayer.id,wasGrouped=imageLayer.grouped;
   stage='text';sale.textItem.contents=String(item.price);orig.textItem.contents='\uffe5'+item.originalPrice;saving.textItem.contents='\u7acb\u7701 '+item.saving;
   stage='price-position';var sb=bounds(sale),ob=bounds(orig),cb=bounds(currency);currency.translate(UnitValue(sb[0]-currencyGap-cb[2],'px'),UnitValue(0,'px'));orig.translate(UnitValue(sb[2]+gap-ob[0],'px'),UnitValue(0,'px'));cb=bounds(currency);ob=bounds(orig);var dx=clusterCenter-(cb[0]+ob[2])/2;currency.translate(UnitValue(dx,'px'),UnitValue(0,'px'));sale.translate(UnitValue(dx,'px'),UnitValue(0,'px'));orig.translate(UnitValue(dx,'px'),UnitValue(0,'px'));
   var gradient;
