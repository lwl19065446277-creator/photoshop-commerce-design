  var updated=[];for(i=0;i<records.length;i++)updated.push(nativeLayer(records[i].groupId));var finalAudit=auditDocument(doc,updated);finalAudit.scope='updated-product-groups';doc.close(SaveOptions.DONOTSAVECHANGES);doc=null;var reopened=app.open(psd),reopenedGroups=[];for(i=0;i<records.length;i++)reopenedGroups.push(nativeLayer(records[i].groupId,reopened));var reopen=snapshot(reopened,reopenedGroups);reopen.scope='updated-product-groups';reopened.close(SaveOptions.DONOTSAVECHANGES);progress({phase:'complete',reopenedId:reopen.id});return{backend:'real-com',kind:p.kind,name:p.name,psd:psd.fsName,png:png.fsName,jpg:jpg.fsName,width:p.width,height:p.height,sourceSnapshot:original,steps:records,audit:finalAudit,reopen:reopen,sliceExports:slices};
 }catch(e){e.details=e.details||{};e.details.stage=stage;e.details.line=e.line;e.details.number=e.number;if(doc){e.details.partialDocumentId=doc.id;e.details.itemIndex=i;}throw e;}
