   doc.activeLayer=nativeLayer(addedId);executeAction(stringIDToTypeID('newPlacedLayer'),undefined,DialogModes.NO);imageLayer=doc.activeLayer;var imageId=imageLayer.id;
   stage='image-transform';var ib=bounds(imageLayer),scale=(imageBounds[2]-imageBounds[0])/(ib[2]-ib[0])*100;imageLayer.resize(scale,scale,AnchorPosition.MIDDLECENTER);ib=bounds(imageLayer);imageLayer.translate(UnitValue(imageBounds[0]-ib[0],'px'),UnitValue(imageBounds[1]-ib[1],'px'));imageLayer.move(nativeLayer(oldImageId),ElementPlacement.PLACEBEFORE);imageLayer=nativeLayer(imageId);imageLayer.grouped=wasGrouped;imageLayer.name='GRAY_LOGO_'+item.id;imageLayer.visible=true;
   var col=i%2,row=Math.floor(i/2);stage='group-position';g=nativeLayer(groupId);g.translate(UnitValue(col*p.columnStep,'px'),UnitValue(row*p.rowStep,'px'));sale=nativeLayer(saleId);orig=nativeLayer(origId);saving=nativeLayer(savingId);imageLayer=nativeLayer(imageId);
   stage='gradient';gradient=recolor(nativeLayer(priceBoxId));
   if(sale.textItem.contents!==String(item.price)||orig.textItem.contents!=='\uffe5'+item.originalPrice||saving.textItem.contents!=='\u7acb\u7701 '+item.saving||sale.textItem.font!==fonts.sale||orig.textItem.font!==fonts.original||saving.textItem.font!==fonts.saving)throw problem('READBACK_MISMATCH','Native text or fonts differ');
   var rec={position:i+1,id:item.id,sku:item.sku,groupId:g.id,imageId:imageLayer.id,imageSource:item.path,imageSha256:item.sha256,originalTexts:originals,price:item.price,originalPrice:item.originalPrice,saving:item.saving,fonts:fonts,gradient:gradient,layers:layerInfo(g,doc.id)};records.push(rec);progress({phase:'item',position:i+1,id:item.id});
  }}catch(updateError){historyError=updateError;}};
  try{doc.suspendHistory('Design Agent native catalog','$.global._studioNativeCatalogHistory()');}finally{$.global._studioNativeCatalogHistory=undefined;}
