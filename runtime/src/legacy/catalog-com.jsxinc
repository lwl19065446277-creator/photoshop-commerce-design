 function output(path){var f=fileFor(path);if(canon(f.parent)!==root||f.exists)throw problem('INVALID_OUTPUT','Native outputs must be new siblings');return f;}
 function desc(l){var r=new ActionReference();r.putIdentifier(charIDToTypeID('Lyr '),l.id);return executeActionGet(r);}
 function nativeLayer(layerId,documentOverride){var d=documentOverride||doc;app.activeDocument=d;var action=new ActionDescriptor(),r=new ActionReference();r.putIdentifier(charIDToTypeID('Lyr '),layerId);action.putReference(charIDToTypeID('null'),r);action.putBoolean(charIDToTypeID('MkVs'),false);executeAction(charIDToTypeID('slct'),action,DialogModes.NO);var l=d.activeLayer;if(l.id!==layerId||app.activeDocument.id!==d.id)throw problem('LAYER_ID_MISMATCH','Direct native ID lookup selected the wrong layer');return l;}
 function bounds(l){var d=desc(l),b=d.getObjectValue(stringIDToTypeID('boundsNoEffects'));return[b.getUnitDoubleValue(stringIDToTypeID('left')),b.getUnitDoubleValue(stringIDToTypeID('top')),b.getUnitDoubleValue(stringIDToTypeID('right')),b.getUnitDoubleValue(stringIDToTypeID('bottom'))];}
