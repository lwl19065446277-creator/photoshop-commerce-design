/* Fresh-document renderer. Static operations + strict JSON data, never eval. */
function parseDataJSON(source) {
    var at=0, ch=' ';
    function fail(){throw new Error('Invalid plan JSON at '+at);}
    function next(){ch=source.charAt(at++);return ch;}
    function white(){while(ch && ch<=' ')next();}
    function str(){var out='',hex,i,u;if(ch!=='"')fail();while(next()) {if(ch==='"'){next();return out;}if(ch==='\\'){next();if(ch==='u'){u=0;for(i=0;i<4;i++){hex=parseInt(next(),16);if(!isFinite(hex))fail();u=u*16+hex;}out+=String.fromCharCode(u);}else {var esc={'"':'"','\\':'\\','/':'/','b':'\b','f':'\f','n':'\n','r':'\r','t':'\t'};if(!esc.hasOwnProperty(ch))fail();out+=esc[ch];}}else{if(ch<' ')fail();out+=ch;}}fail();}
    function val(){white();var out,key,num='';if(ch==='"')return str();if(ch==='{'){out={};next();white();if(ch==='}'){next();return out;}while(ch){key=str();if(key==='__proto__'||key==='constructor'||key==='prototype'||out.hasOwnProperty(key))fail();white();if(ch!==':')fail();next();out[key]=val();white();if(ch==='}'){next();return out;}if(ch!==',')fail();next();white();}fail();}if(ch==='['){out=[];next();white();if(ch===']'){next();return out;}while(ch){out.push(val());white();if(ch===']'){next();return out;}if(ch!==',')fail();next();}fail();}if(ch==='-'||(ch>='0'&&ch<='9')){while(ch&&/[0-9eE+\-.]/.test(ch)){num+=ch;next();}if(!/^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?$/.test(num))fail();return Number(num);}var words=['true','false','null'],v=[true,false,null],j,k;for(j=0;j<3;j++)if(ch===words[j].charAt(0)){for(k=0;k<words[j].length;k++){if(ch!==words[j].charAt(k))fail();next();}return v[j];}fail();}
    next();var result=val();white();if(ch)fail();return result;
}
function renderDesign(planPath) {
    var planFile=fileFor(planPath),root=canon(planFile.parent),plan,doc=null,sourceDoc=null,records=[],oldRulers=app.preferences.rulerUnits,oldType=app.preferences.typeUnits;
    if(root.indexOf('/runs/')<0 || !/\.json$/i.test(planFile.name)||!planFile.exists)throw problem('INVALID_PLAN','Plan must be an existing JSON file in runs');
    planFile.encoding='UTF8';planFile.open('r');try{plan=parseDataJSON(planFile.read());}finally{planFile.close();}
    function localOutput(p){var f=fileFor(p);if(canon(f.parent)!==root||f.exists)throw problem('INVALID_OUTPUT','New files must stay beside plan and must not exist',{path:p});return f;}
    function color(hex){if(!/^[0-9a-f]{6}$/i.test(hex))throw problem('INVALID_COLOR','Expected six hex digits');var c=new SolidColor();c.rgb.hexValue=hex;return c;}
    function finite(v,low,high){if(typeof v!=='number'||!isFinite(v)||v<low||v>high)throw problem('INVALID_GEOMETRY','Plan geometry outside allowed range');return v;}
    function asset(p){var f=fileFor(p),n=canon(f);if(!(n.indexOf('c:/users/edy/desktop/\u53cc11/')===0||n.indexOf(root+'/')===0||n.indexOf('c:/users/edy/documents/chatgpt/\u5e73\u9762\u8bbe\u8ba1/runs/')===0))throw problem('ASSET_OUTSIDE_ROOT','Asset is outside explicitly authorized roots');if(!f.exists)throw problem('ASSET_MISSING','Asset does not exist',{path:p});return f;}
    function savePng(d,f){var o=new PNGSaveOptions();o.compression=6;d.saveAs(f,o,true,Extension.LOWERCASE);}
    function sameSize(layer,box,fit){var b=layer.bounds,w=pixels(b[2])-pixels(b[0]),h=pixels(b[3])-pixels(b[1]);if(w<=0||h<=0)throw problem('EMPTY_ASSET','Asset layer is empty');var scale=Math.min(box[2]/w,box[3]/h)*100;if(fit==='cover')scale=Math.max(box[2]/w,box[3]/h)*100;layer.resize(scale,scale,AnchorPosition.MIDDLECENTER);b=layer.bounds;w=pixels(b[2])-pixels(b[0]);h=pixels(b[3])-pixels(b[1]);layer.translate(UnitValue(box[0]+(box[2]-w)/2-pixels(b[0]),'px'),UnitValue(box[1]+(box[3]-h)/2-pixels(b[1]),'px'));}
    function groupFor(name){var j;for(j=0;j<doc.layerSets.length;j++)if(doc.layerSets[j].name===name)return doc.layerSets[j];var g=doc.layerSets.add();g.name=name;return g;}
    function solidRect(spec){
        var desc=new ActionDescriptor(),ref=new ActionReference(),content=new ActionDescriptor(),fill=new ActionDescriptor(),rgb=new ActionDescriptor(),shape=new ActionDescriptor();
        ref.putClass(stringIDToTypeID('contentLayer'));desc.putReference(charIDToTypeID('null'),ref);
        var c=color(spec.color);rgb.putDouble(charIDToTypeID('Rd  '),c.rgb.red);rgb.putDouble(charIDToTypeID('Grn '),c.rgb.green);rgb.putDouble(charIDToTypeID('Bl  '),c.rgb.blue);
        fill.putObject(charIDToTypeID('Clr '),charIDToTypeID('RGBC'),rgb);content.putObject(charIDToTypeID('Type'),stringIDToTypeID('solidColorLayer'),fill);
        shape.putUnitDouble(charIDToTypeID('Top '),charIDToTypeID('#Pxl'),spec.y);shape.putUnitDouble(charIDToTypeID('Left'),charIDToTypeID('#Pxl'),spec.x);shape.putUnitDouble(charIDToTypeID('Btom'),charIDToTypeID('#Pxl'),spec.y+spec.height);shape.putUnitDouble(charIDToTypeID('Rght'),charIDToTypeID('#Pxl'),spec.x+spec.width);
        if(spec.radius)shape.putUnitDouble(charIDToTypeID('Rds '),charIDToTypeID('#Pxl'),spec.radius);
        content.putObject(charIDToTypeID('Shp '),charIDToTypeID('Rctn'),shape);desc.putObject(charIDToTypeID('Usng'),stringIDToTypeID('contentLayer'),content);
        executeAction(charIDToTypeID('Mk  '),desc,DialogModes.NO);return doc.activeLayer;
    }
    function clipMask(layer,spec,hasMask){
        doc.activeLayer=layer;var d=new ActionDescriptor(),r=new ActionReference();
        if(!hasMask){d.putClass(charIDToTypeID('Nw  '),charIDToTypeID('Chnl'));r.putEnumerated(charIDToTypeID('Chnl'),charIDToTypeID('Chnl'),charIDToTypeID('Msk '));d.putReference(charIDToTypeID('At  '),r);d.putEnumerated(charIDToTypeID('Usng'),charIDToTypeID('UsrM'),charIDToTypeID('RvlA'));executeAction(charIDToTypeID('Mk  '),d,DialogModes.NO);}
        else{r.putEnumerated(charIDToTypeID('Chnl'),charIDToTypeID('Chnl'),charIDToTypeID('Msk '));d.putReference(charIDToTypeID('null'),r);executeAction(charIDToTypeID('slct'),d,DialogModes.NO);}
        var rad=Math.min(spec.radius,spec.width/2,spec.height/2),centers=[[spec.x+spec.width-rad,spec.y+rad],[spec.x+spec.width-rad,spec.y+spec.height-rad],[spec.x+rad,spec.y+spec.height-rad],[spec.x+rad,spec.y+rad]],points=[],q,k,ang;
        for(q=0;q<4;q++)for(k=0;k<=8;k++){ang=(-90+q*90+k*90/8)*Math.PI/180;points.push([centers[q][0]+Math.cos(ang)*rad,centers[q][1]+Math.sin(ang)*rad]);}
        doc.selection.select(points,SelectionType.REPLACE,0,true);doc.selection.invert();d=new ActionDescriptor();d.putEnumerated(charIDToTypeID('Usng'),charIDToTypeID('FlCn'),charIDToTypeID('Blck'));d.putUnitDouble(charIDToTypeID('Opct'),charIDToTypeID('#Prc'),100);d.putEnumerated(charIDToTypeID('Md  '),charIDToTypeID('BlnM'),charIDToTypeID('Nrml'));executeAction(charIDToTypeID('Fl  '),d,DialogModes.NO);doc.selection.deselect();doc.activeChannels=doc.componentChannels;
    }
    function gradientMask(layer,spec){
        doc.activeLayer=layer;
        var d=new ActionDescriptor(),r=new ActionReference(),a=new ActionReference();
        d.putClass(charIDToTypeID('Nw  '),charIDToTypeID('Chnl'));a.putEnumerated(charIDToTypeID('Chnl'),charIDToTypeID('Chnl'),charIDToTypeID('Msk '));d.putReference(charIDToTypeID('At  '),a);d.putEnumerated(charIDToTypeID('Usng'),charIDToTypeID('UsrM'),charIDToTypeID('RvlA'));executeAction(charIDToTypeID('Mk  '),d,DialogModes.NO);
        d=new ActionDescriptor();var p1=new ActionDescriptor(),p2=new ActionDescriptor();p1.putUnitDouble(charIDToTypeID('Hrzn'),charIDToTypeID('#Pxl'),spec.from[0]);p1.putUnitDouble(charIDToTypeID('Vrtc'),charIDToTypeID('#Pxl'),spec.from[1]);p2.putUnitDouble(charIDToTypeID('Hrzn'),charIDToTypeID('#Pxl'),spec.to[0]);p2.putUnitDouble(charIDToTypeID('Vrtc'),charIDToTypeID('#Pxl'),spec.to[1]);d.putObject(charIDToTypeID('From'),charIDToTypeID('Pnt '),p1);d.putObject(charIDToTypeID('T   '),charIDToTypeID('Pnt '),p2);d.putEnumerated(charIDToTypeID('Type'),charIDToTypeID('GrdT'),charIDToTypeID('Lnr '));d.putBoolean(charIDToTypeID('Dthr'),true);d.putBoolean(charIDToTypeID('UsMs'),true);
        var gr=new ActionDescriptor(),cl=new ActionList(),tr=new ActionList(),k,stop,c;gr.putString(charIDToTypeID('Nm  '),'White to black mask');gr.putEnumerated(charIDToTypeID('GrdF'),charIDToTypeID('GrdF'),charIDToTypeID('CstS'));gr.putDouble(charIDToTypeID('Intr'),4096);
        for(k=0;k<2;k++){stop=new ActionDescriptor();c=new ActionDescriptor();var v=255;if(k===1)v=0;c.putDouble(charIDToTypeID('Rd  '),v);c.putDouble(charIDToTypeID('Grn '),v);c.putDouble(charIDToTypeID('Bl  '),v);stop.putObject(charIDToTypeID('Clr '),charIDToTypeID('RGBC'),c);stop.putEnumerated(charIDToTypeID('Type'),charIDToTypeID('Clry'),charIDToTypeID('UsrS'));stop.putInteger(charIDToTypeID('Lctn'),k*4096);stop.putInteger(charIDToTypeID('Mdpn'),50);cl.putObject(charIDToTypeID('Clrt'),stop);stop=new ActionDescriptor();stop.putUnitDouble(charIDToTypeID('Opct'),charIDToTypeID('#Prc'),100);stop.putInteger(charIDToTypeID('Lctn'),k*4096);stop.putInteger(charIDToTypeID('Mdpn'),50);tr.putObject(charIDToTypeID('TrnS'),stop);}gr.putList(charIDToTypeID('Clrs'),cl);gr.putList(charIDToTypeID('Trns'),tr);d.putObject(charIDToTypeID('Grad'),charIDToTypeID('Grdn'),gr);executeAction(charIDToTypeID('Grdn'),d,DialogModes.NO);
        if(spec.feather){d=new ActionDescriptor();r=new ActionReference();r.putIdentifier(charIDToTypeID('Lyr '),layer.id);d.putReference(charIDToTypeID('null'),r);var props=new ActionDescriptor();props.putUnitDouble(stringIDToTypeID('userMaskFeather'),charIDToTypeID('#Pxl'),spec.feather);d.putObject(charIDToTypeID('T   '),charIDToTypeID('Lyr '),props);executeAction(charIDToTypeID('setd'),d,DialogModes.NO);}
        doc.activeChannels=doc.componentChannels;
    }
    try {
        app.preferences.rulerUnits=Units.PIXELS;app.preferences.typeUnits=TypeUnits.PIXELS;
        if(plan.kind==='extract'){
            var output=localOutput(plan.output);sourceDoc=app.open(asset(plan.source));
            if(plan.isolateLayerId){var selected=findLayer(sourceDoc.layers,plan.isolateLayerId);if(!selected)throw problem('LAYER_NOT_FOUND','Extraction layer missing');doc=app.documents.add(sourceDoc.width,sourceDoc.height,sourceDoc.resolution,'asset',NewDocumentMode.RGB,DocumentFill.TRANSPARENT,1,BitsPerChannelType.EIGHT,'sRGB IEC61966-2.1');app.activeDocument=sourceDoc;sourceDoc.activeLayer=selected;var extractedLayer=selected.duplicate(doc,ElementPlacement.PLACEATBEGINNING);app.activeDocument=doc;doc.activeLayer=extractedLayer;extractedLayer.visible=true;try{extractedLayer.grouped=false;}catch(noClipping){}if(plan.trim)doc.trim(TrimType.TRANSPARENT,true,true,true,true);}
            else {for(var hi=0;hi<plan.hideIds.length;hi++){var hide=findLayer(sourceDoc.layers,plan.hideIds[hi]);if(!hide)throw problem('LAYER_NOT_FOUND','Hidden reference layer missing');hide.visible=false;}doc=sourceDoc.duplicate('scene-extraction',true);app.activeDocument=doc;if(doc.mode!==DocumentMode.RGB)doc.changeMode(ChangeMode.RGB);doc.convertProfile('sRGB IEC61966-2.1',Intent.RELATIVECOLORIMETRIC,true,true);}
            savePng(doc,output);var extracted={backend:'real-com',kind:'extract',path:output.fsName,width:pixels(doc.width),height:pixels(doc.height)};doc.close(SaveOptions.DONOTSAVECHANGES);doc=null;sourceDoc.close(SaveOptions.DONOTSAVECHANGES);sourceDoc=null;return extracted;
        }
        if(plan.kind!=='compose')throw problem('UNKNOWN_PLAN','Only extract and compose plans are permitted');
        finite(plan.width,1,20000);finite(plan.height,1,20000);
        var psd=localOutput(plan.psd),png=localOutput(plan.png),jpg=plan.jpg?localOutput(plan.jpg):null;
        var progressFile=localOutput(planFile.parent.fsName+'/render-progress.jsonl');
        function progress(entry){progressFile.encoding='UTF8';if(!progressFile.open('a'))throw problem('JOURNAL_WRITE_FAILED','Cannot append native operation progress');try{progressFile.writeln(json(entry));}finally{progressFile.close();}}
        progress({phase:'started',layers:plan.layers.length,slices:plan.slices?plan.slices.length:0});
        var sliceTargets=[],sliceRecords=[],si,ss;
        if(plan.slices)for(si=0;si<plan.slices.length;si++){ss=plan.slices[si];finite(ss.x,0,plan.width);finite(ss.y,0,plan.height);finite(ss.width,1,plan.width);finite(ss.height,1,plan.height);if(ss.x+ss.width>plan.width||ss.y+ss.height>plan.height)throw problem('INVALID_SLICE','Slice outside canvas');sliceTargets.push({spec:ss,png:ss.png?localOutput(ss.png):null,jpg:ss.jpg?localOutput(ss.jpg):null});}
        var j,s,layer,g,b,desiredFont;
        // Validate every font and input before creating any document.
        for(j=0;j<plan.layers.length;j++){s=plan.layers[j];if(s.type==='image')asset(s.path);else if(s.type==='text'){try{desiredFont=app.fonts.getByName(s.font);}catch(fontMissing){throw problem('FONT_MISSING','Required font is unavailable',{font:s.font});}}else if(s.type!=='rect')throw problem('UNKNOWN_LAYER_OPERATION','Unsupported layer type');}
        doc=app.documents.add(UnitValue(plan.width,'px'),UnitValue(plan.height,'px'),72,plan.name,NewDocumentMode.RGB,DocumentFill.TRANSPARENT,1,BitsPerChannelType.EIGHT,'sRGB IEC61966-2.1');
        if(plan.groupOrder){for(j=0;j<plan.groupOrder.length;j++)groupFor(plan.groupOrder[j]);}
        for(j=0;j<plan.layers.length;j++){
            s=plan.layers[j];app.activeDocument=doc;
            if(s.type==='rect'){finite(s.x,-20000,20000);finite(s.y,-20000,20000);finite(s.width,1,20000);finite(s.height,1,20000);layer=solidRect(s);}
            else if(s.type==='image'){
                sourceDoc=app.open(asset(s.path));if(s.crop)sourceDoc.crop([UnitValue(s.crop[0],'px'),UnitValue(s.crop[1],'px'),UnitValue(s.crop[2],'px'),UnitValue(s.crop[3],'px')]);
                if(sourceDoc.layers.length>1)sourceDoc.mergeVisibleLayers();layer=sourceDoc.activeLayer.duplicate(doc,ElementPlacement.PLACEATBEGINNING);sourceDoc.close(SaveOptions.DONOTSAVECHANGES);sourceDoc=null;app.activeDocument=doc;doc.activeLayer=layer;
                executeAction(stringIDToTypeID('newPlacedLayer'),undefined,DialogModes.NO);layer=doc.activeLayer;sameSize(layer,s.box,s.fit);
                if(s.tint){layer.rasterize(RasterizeType.ENTIRELAYER);if(s.tint!=='000000'&&s.tint!=='FFFFFF')throw problem('UNSUPPORTED_TINT','Only black and white logo tints are supported');if(s.path.indexOf('brand-knkw.png')>=0){if(s.tint==='000000')layer.invert();}else{layer.desaturate();if(s.tint==='000000')layer.threshold(254);else layer.threshold(1);}}
            }else{
                layer=doc.artLayers.add();doc.activeLayer=layer;layer.kind=LayerKind.TEXT;var t=layer.textItem;t.contents=s.text;t.font=s.font;t.size=UnitValue(finite(s.size,1,1296),'px');t.color=color(s.color);t.position=[UnitValue(s.x,'px'),UnitValue(s.y,'px')];
                // ExtendScript's legacy ternary associativity differs here. Use explicit branches.
                if(s.align==='center')t.justification=Justification.CENTER;else if(s.align==='right')t.justification=Justification.RIGHT;else t.justification=Justification.LEFT;
                if(s.italic)t.fauxItalic=true;if(s.strike)t.strikeThru=StrikeThruType.STRIKEHEIGHT;t.antiAliasMethod=AntiAlias.SHARP;if(s.tracking!==undefined)t.tracking=s.tracking;if(s.leading){t.useAutoLeading=false;t.leading=UnitValue(s.leading,'px');}
                t.position=[UnitValue(s.x,'px'),UnitValue(s.y,'px')];
                b=layer.bounds;var initialBounds=[pixels(b[0]),pixels(b[1]),pixels(b[2]),pixels(b[3])];var actualAnchor=pixels(b[0]);if(s.align==='center')actualAnchor=(pixels(b[0])+pixels(b[2]))/2;else if(s.align==='right')actualAnchor=pixels(b[2]);layer.translate(UnitValue(s.x-actualAnchor,'px'),UnitValue(0,'px'));b=layer.bounds;var shiftedBounds=[pixels(b[0]),pixels(b[1]),pixels(b[2]),pixels(b[3])];
                b=layer.bounds;if(s.maxWidth && pixels(b[2])-pixels(b[0])>s.maxWidth)throw problem('TEXT_TOO_WIDE','Text exceeds planned safe width',{name:s.name,text:s.text});
                if(t.font!==s.font)throw problem('FONT_SUBSTITUTED','Photoshop substituted a font',{requested:s.font,actual:t.font});
            }
            if(s.type==='image'&&s.anchor==='bottom'){b=layer.bounds;layer.translate(0,s.box[1]+s.box[3]-pixels(b[3]));}
            if(s.subjectMask){doc.activeLayer=layer;var cut=new ActionDescriptor();cut.putBoolean(stringIDToTypeID('sampleAllLayers'),false);executeAction(stringIDToTypeID('autoCutout'),cut,DialogModes.NO);var md=new ActionDescriptor(),ma=new ActionReference();md.putClass(charIDToTypeID('Nw  '),charIDToTypeID('Chnl'));ma.putEnumerated(charIDToTypeID('Chnl'),charIDToTypeID('Chnl'),charIDToTypeID('Msk '));md.putReference(charIDToTypeID('At  '),ma);md.putEnumerated(charIDToTypeID('Usng'),charIDToTypeID('UsrM'),charIDToTypeID('RvlS'));executeAction(charIDToTypeID('Mk  '),md,DialogModes.NO);doc.selection.deselect();doc.activeChannels=doc.componentChannels;}
            if(s.gradientMask)gradientMask(layer,s.gradientMask);
            if(s.clip)clipMask(layer,s.clip,Boolean(s.gradientMask||s.subjectMask));
            layer.name=s.name;if(s.opacity!==undefined)layer.opacity=finite(s.opacity,0,100);g=groupFor(s.group);layer.move(g,ElementPlacement.INSIDE);
            b=layer.bounds;var rec={step:j+1,id:layer.id,type:s.type,name:s.name,bounds:{left:pixels(b[0]),top:pixels(b[1]),right:pixels(b[2]),bottom:pixels(b[3])}};if(s.type==='text'){rec.text=layer.textItem.contents;rec.font=layer.textItem.font;rec.requestedAlign=s.align;rec.actualAlign=String(layer.textItem.justification);rec.initialBounds=initialBounds;rec.shiftedBounds=shiftedBounds;rec.actualAnchor=actualAnchor;}if(s.gradientMask)rec.gradientMask=s.gradientMask;records.push(rec);progress({phase:'layer',step:j+1,total:plan.layers.length,id:layer.id,name:s.name});
        }
        var opts=new PhotoshopSaveOptions();opts.layers=true;opts.embedColorProfile=true;opts.maximizeCompatibility=true;app.preferences.maximizeCompatibility=QueryStateType.ALWAYS;doc.saveAs(psd,opts,false,Extension.LOWERCASE);
        savePng(doc,png);
        if(jpg){var jo=new JPEGSaveOptions();jo.quality=11;jo.embedColorProfile=true;doc.saveAs(jpg,jo,true,Extension.LOWERCASE);}
        progress({phase:'full_exports_saved'});
        for(si=0;si<sliceTargets.length;si++){
            var target=sliceTargets[si],sliceDoc=null;ss=target.spec;app.activeDocument=doc;
            try{sliceDoc=doc.duplicate('slice-export-'+si,true);app.activeDocument=sliceDoc;sliceDoc.crop([UnitValue(ss.x,'px'),UnitValue(ss.y,'px'),UnitValue(ss.x+ss.width,'px'),UnitValue(ss.y+ss.height,'px')]);if(target.png)savePng(sliceDoc,target.png);if(target.jpg){var sj=new JPEGSaveOptions();sj.quality=11;sj.embedColorProfile=true;sliceDoc.saveAs(target.jpg,sj,true,Extension.LOWERCASE);}sliceRecords.push({name:ss.name,x:ss.x,y:ss.y,width:pixels(sliceDoc.width),height:pixels(sliceDoc.height),png:target.png?target.png.fsName:null,jpg:target.jpg?target.jpg.fsName:null});}
            finally{if(sliceDoc)sliceDoc.close(SaveOptions.DONOTSAVECHANGES);app.activeDocument=doc;}
            progress({phase:'slice',index:si+1,total:sliceTargets.length,name:ss.name});
        }
        var result={backend:'real-com',kind:'compose',documentId:doc.id,psd:psd.fsName,png:png.fsName,jpg:jpg?jpg.fsName:null,width:pixels(doc.width),height:pixels(doc.height),steps:records,sliceExports:sliceRecords};
        doc.close(SaveOptions.DONOTSAVECHANGES);doc=null;
        var reopened=app.open(psd),check=snapshot(reopened);result.reopen={documentId:reopened.id,width:check.width,height:check.height,layers:check.layers,colorProfile:check.colorProfile};reopened.close(SaveOptions.DONOTSAVECHANGES);progress({phase:'complete',reopenedDocumentId:check.id});return result;
    } catch(error){if(doc){try{error.details=error.details||{};error.details.partialDocumentId=doc.id;error.details.step=j;error.details.layer=s?{type:s.type,name:s.name}:null;error.details.activeLayer=doc.activeLayer.name;}catch(ignore){}}throw error;}
    finally{if(sourceDoc){try{sourceDoc.close(SaveOptions.DONOTSAVECHANGES);}catch(ignoreClose){}}app.preferences.rulerUnits=oldRulers;app.preferences.typeUnits=oldType;}
}
