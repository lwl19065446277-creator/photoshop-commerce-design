                    "type": "string",
                    "pattern": "^[0-9a-f]{6}$"
                  },
                  "align": {
                    "type": "string",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  },
                  "maxWidth": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "tracking": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 10000
                  },
                  "leading": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "italic": {
                    "type": "boolean"
                  },
                  "strike": {
                    "type": "boolean"
                  }
