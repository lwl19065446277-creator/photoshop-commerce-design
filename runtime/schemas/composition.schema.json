                      {
                        "$ref": "#/definitions/Composition/properties/layers/items/anyOf/0/properties/x"
                      },
                      {
                        "$ref": "#/definitions/Composition/properties/layers/items/anyOf/0/properties/x"
                      },
                      {
                        "$ref": "#/definitions/Composition/properties/layers/items/anyOf/0/properties/x"
                      },
                      {
                        "$ref": "#/definitions/Composition/properties/layers/items/anyOf/0/properties/x"
                      }
                    ]
