        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "psd": {
          "type": "string",
          "minLength": 1
        },
        "png": {
          "type": "string",
          "minLength": 1
        },
        "jpg": {
          "type": "string",
          "minLength": 1
